---
// The newest published release of Nodearr, read from GitHub when the site is built. The site is
// built again whenever a release is published, so this is never older than the newest release.
// When GitHub cannot be reached, the page points to the Releases page instead.

const releasesPage = 'https://github.com/Nodearr/Nodearr/releases';

type Asset = { name: string; browser_download_url: string; size: number };
type Release = { tag_name: string; name: string; html_url: string; prerelease: boolean; draft: boolean; published_at: string; assets: Asset[] };

let release: Release | undefined;

try {
  const headers: Record<string, string> = { Accept: 'application/vnd.github+json' };
  if (import.meta.env.GITHUB_TOKEN) headers.Authorization = `Bearer ${import.meta.env.GITHUB_TOKEN}`;

  const response = await fetch('https://api.github.com/repos/Nodearr/Nodearr/releases?per_page=10', { headers });
  if (response.ok) {
    release = ((await response.json()) as Release[]).find((r) => !r.draft);
  }
} catch {
  // Shown as a link to the Releases page.
}

// Each platform's packages, the way Sonarr lists them: the one most people want first.
const platforms = [
  {
    name: 'Windows',
    packages: [
      { label: 'Installer, 64-bit', match: /win-x64-installer\.exe$/ },
      { label: 'Zip, 64-bit', match: /win-x64\.zip$/ },
      { label: 'Installer, 32-bit', match: /win-x86-installer\.exe$/ },
      { label: 'Zip, 32-bit', match: /win-x86\.zip$/ },
    ],
    note: 'The installer puts Nodearr in Program Files and starts it in the tray when you sign in, or as a service.',
  },
  {
    name: 'macOS',
    packages: [
      { label: 'Apple silicon', match: /osx-arm64\.tar\.gz$/ },
      { label: 'Intel', match: /osx-x64\.tar\.gz$/ },
    ],
    note: 'Unpack it and start ./Nodearr.',
  },
  {
    name: 'Linux',
    packages: [
      { label: 'x64', match: /linux-x64\.tar\.gz$/ },
      { label: 'ARM64', match: /linux-arm64\.tar\.gz$/ },
      { label: 'ARM, 32-bit', match: /linux-arm\.tar\.gz$/ },
      { label: 'x64, musl (Alpine)', match: /linux-musl-x64\.tar\.gz$/ },
      { label: 'ARM64, musl (Alpine)', match: /linux-musl-arm64\.tar\.gz$/ },
    ],
    note: 'Unpack it and start ./Nodearr.',
  },
];

const assets = release?.assets ?? [];
const sums = assets.find((a) => a.name === 'SHA256SUMS');
const megabytes = (size: number) => `${Math.max(1, Math.round(size / 1024 / 1024))} MB`;
const published = release ? new Date(release.published_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
---

{
  release ? (
    <div class="release">
      <p>
        <strong>{release.name || release.tag_name}</strong>, published {published}
        {release.prerelease ? ', a pre-release' : ''}. <a href={release.html_url}>Release notes</a>.
      </p>

      {platforms.map((platform) => (
        <section>
          <h2>{platform.name}</h2>
          <ul>
            {platform.packages.map((p) => {
              const asset = assets.find((a) => p.match.test(a.name));
              return asset ? (
                <li>
                  <a href={asset.browser_download_url}>{p.label}</a> <span class="muted">{asset.name}, {megabytes(asset.size)}</span>
                </li>
              ) : null;
            })}
          </ul>
          <p class="muted">{platform.note}</p>
        </section>
      ))}

      <section>
        <h2>Docker</h2>
        <p>
          For amd64 and arm64. Start from <a href={`https://github.com/Nodearr/Nodearr/blob/${release.tag_name}/docker/docker-compose.yml`}>docker-compose.yml</a>, which explains the two things that have to be right: the shared downloads folder and the networking.
        </p>
        <pre><code>{`docker pull ghcr.io/nodearr/nodearr:${release.tag_name.replace(/^v/, '')}`}</code></pre>
      </section>

      {sums ? (
        <p class="muted">
          Check a download against <a href={sums.browser_download_url}>SHA256SUMS</a>.
        </p>
      ) : null}
    </div>
  ) : (
    <p>
      Downloads are on the <a href={releasesPage}>Releases</a> page.
    </p>
  )
}

<style>
  .muted {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .release section h2 {
    margin-top: 1.5rem;
  }
</style>
