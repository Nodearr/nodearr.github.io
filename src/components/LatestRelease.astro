---
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
import TabAnchors from './TabAnchors.astro';
import { getLatestRelease, platforms, releasesPage } from '../lib/releases';
// Downloads from the first non-draft release GitHub returns, including pre-releases, at build time.
// Publishing a release requests a site rebuild; the page keeps its build-time result until the
// next successful deployment. A failed or empty API response leaves a link to the Releases page.
// This lookup is independent of the ref used to sync the guide for a manual preview.

const release = await getLatestRelease();

const assets = release?.assets ?? [];
const sums = assets.find((a) => a.name === 'SHA256SUMS');
const megabytes = (size: number) => `${Math.max(1, Math.round(size / 1024 / 1024))} MB`;
const published = release ? new Date(release.published_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
---

{
  release ? (
    <div class="release">
      <p>
        <strong>{release.name || release.tag_name}</strong>, published {published}
        {release.prerelease ? ', a pre-release' : ''}. <a href={release.html_url}>Release notes</a>.
      </p>

      <Tabs syncKey="platform">
        {platforms.map((platform) => (
          <TabItem label={platform.name}>
            <h2 id={platform.name.toLowerCase()}>{platform.name}</h2>
            <ul>
              {platform.packages.map((p) => {
                const asset = assets.find((a) => p.match.test(a.name));
                return asset ? (
                  <li>
                    <a href={asset.browser_download_url}>{p.label}</a> <span class="muted">{asset.name}, {megabytes(asset.size)}</span>
                  </li>
                ) : null;
              })}
            </ul>
            <p class="muted">{platform.note}</p>
            <p><a href={platform.guide}>{platform.name} installation instructions</a></p>
          </TabItem>
        ))}

        <TabItem label="Docker">
          <h2 id="docker">Docker</h2>
          <p>
            For amd64 and arm64. Start from <a href={`https://github.com/Nodearr/Nodearr/blob/${release.tag_name}/docker/docker-compose.yml`}>docker-compose.yml</a>, which explains the two things that have to be right: the shared downloads folder and the networking.
          </p>
          <Code code={`docker pull ghcr.io/nodearr/nodearr:${release.tag_name.replace(/^v/, '')}`} lang="sh" />
          <p><a href="/guide/installing/#docker">Docker installation instructions</a></p>
        </TabItem>
      </Tabs>

      <TabAnchors />

      {sums ? (
        <p class="muted">
          Check a download against <a href={sums.browser_download_url}>SHA256SUMS</a>.
        </p>
      ) : null}
    </div>
  ) : (
    <p>
      Downloads are on the <a href={releasesPage}>Releases</a> page.
    </p>
  )
}

<style>
  .muted {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
